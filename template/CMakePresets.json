{
  "version": 8,
  "configurePresets": [
    {
      "hidden": true,
      "name": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/${presetName}",
      "installDir": "${sourceDir}/.install/${presetName}",
      "cacheVariables": {
        "PX_ACTIVE_PRESET": "${presetName}"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "No optimization, full debug info. Checks are cache options: PX_ENABLE_ASAN, _UBSAN, _TSAN, _MSAN, _LSAN, PX_FORCE_ERRORS (warnings as errors).",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "profile",
      "displayName": "Profile",
      "description": "Optimized with debug info (RelWithDebInfo), for profiling. Checks are cache options: PX_ENABLE_ASAN, _UBSAN, _TSAN, _MSAN, _LSAN, PX_FORCE_ERRORS (warnings as errors).",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized, with LTO. Checks are cache options: PX_ENABLE_ASAN, _UBSAN, _TSAN, _MSAN, _LSAN, PX_FORCE_ERRORS (warnings as errors).",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {"name": "debug", "displayName": "Debug", "configurePreset": "debug"},
    {"name": "profile", "displayName": "Profile", "configurePreset": "profile"},
    {"name": "release", "displayName": "Release", "configurePreset": "release"}
  ],
  "testPresets": [
    {
      "hidden": true,
      "name": "test-base",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8
      }
    },
    {"name": "debug", "displayName": "Debug", "configurePreset": "debug", "inherits": ["test-base"]},
    {"name": "profile", "displayName": "Profile", "configurePreset": "profile", "inherits": ["test-base"]},
    {"name": "release", "displayName": "Release", "configurePreset": "release", "inherits": ["test-base"]}
  ]
}
